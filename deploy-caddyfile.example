{
	http_port 8080
	https_port 8443
	frankenphp {
		# Worker mode: boot the PHP app once and reuse it (and its SQLite
		# connection + opcache) across requests instead of re-booting per hit.
		# The app front controller (web/index.php) detects frankenphp_handle_request
		# and runs a request loop rather than exiting. Adjust the count to taste.
		worker {
			file web/index.php
			num 2
		}
	}
	order php_server before file_server
}

# HTTP on 8080 -> redirect monster.kawasu.wtf to HTTPS on 8443.
# Scoped to this host so other sites you add on :8080 are unaffected.
:8080 {
	@monster host monster.kawasu.wtf
	redir @monster https://monster.kawasu.wtf:8443{uri} permanent
}

# HTTPS on 8443 with a FrankenPHP-managed internal (self-signed) cert
monster.kawasu.wtf:8443 {
	tls internal
	root * /opt/caddy/monster.kawasu.wtf/web
	php_server
	file_server
}
