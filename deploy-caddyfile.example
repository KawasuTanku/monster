{
	http_port 8080
	https_port 8443
#	auto_https off
	frankenphp
	order php_server before file_server
}

# HTTP on 8080 -> redirect monster.kawasu.wtf to HTTPS on 8443.
# Scoped to this host so other sites you add on :8080 are unaffected.
:8080 {
	@monster host monster.kawasu.wtf
	redir @monster https://monster.kawasu.wtf:8443{uri} permanent
}

# HTTPS on 8443 with a FrankenPHP-managed internal (self-signed) cert
monster.kawasu.wtf:8443 {
	tls internal
	root * /opt/caddy/monster.kawasu.wtf/web
	php_server {
		worker {
			file /opt/caddy/monster.kawasu.wtf/web/index.php
			num 2
		}
	}
	file_server
}
