#!/usr/bin/env bash
#
# monster dev server manager
#
# Single fixed-port PHP dev server so we stop accumulating orphaned
# `php -S` processes across testing sessions.
#
# Usage:
#   bin/dev-server start      # idempotent: kills any stray monster php servers first
#   bin/dev-server stop
#   bin/dev-server restart
#   bin/dev-server status
#
# Override the port with MONSTER_DEV_PORT (default 8010).
set -euo pipefail

PORT="${MONSTER_DEV_PORT:-8010}"
HOST="127.0.0.1"
WEB_DIR="$(cd "$(dirname "$0")/../web" && pwd)"
PIDFILE="/tmp/monster-dev-${PORT}.pid"
LOGFILE="/tmp/monster-dev-${PORT}.log"
URL="http://${HOST}:${PORT}/"

# Kill any php dev-server already bound to our host:port (the real conflict),
# regardless of cwd. Never target this shell.
kill_strays() {
  local p
  for p in $(pgrep -f "php.* -S ${HOST}:${PORT}" || true); do
    [ "$p" = "$$" ] && continue
    kill "$p" 2>/dev/null || true
  done
}

is_running() {
  [ -f "$PIDFILE" ] || return 1
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null || echo)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
  if is_running; then
    echo "already running (pid $(cat "$PIDFILE")) -> $URL"
    return 0
  fi
  # Clean up strays from past sessions before claiming the port.
  kill_strays
  sleep 0.5
  echo "starting monster dev server on $URL (log: $LOGFILE)"
  cd "$WEB_DIR"
  nohup /usr/bin/php8.3 -S "${HOST}:${PORT}" index.php > "$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  sleep 1
  if is_running; then
    echo "up: $URL"
  else
    echo "FAILED to start — see $LOGFILE" >&2
    exit 1
  fi
}

stop() {
  if is_running; then
    local pid
    pid="$(cat "$PIDFILE")"
    kill "$pid" 2>/dev/null || true
    rm -f "$PIDFILE"
    echo "stopped (pid $pid)"
  else
    echo "not running (cleaning any strays anyway)"
  fi
  kill_strays
}

status() {
  if is_running; then
    echo "running: $URL (pid $(cat "$PIDFILE"))"
    curl -s -o /dev/null -w "  http status: %{http_code}\n" "$URL" 2>/dev/null || echo "  (no http response)"
  else
    echo "not running"
  fi
}

case "${1:-start}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  status ;;
  *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
